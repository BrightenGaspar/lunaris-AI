# ==========================================
# Lunaris AI Platform Configuration
# ==========================================

# Ollama Local LLM & Embeddings
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.3
EMBED_MODEL=nomic-embed-text

# SearXNG Metasearch Engine
SEARXNG_URL=http://localhost:8080/search

# PostgreSQL + pgvector Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lunaris_ai
DB_USER=lunaris
DB_PASSWORD=lunaris_secure_password

# Gateway Security
LUNARIS_API_KEY=lunaris_dev_token
LUNARIS_AUTH_DISABLED=true
WEBUI_SECRET=lunaris_super_secret_key

# Document Watcher
LUNARIS_WATCH_DIR=./documents
WATCHER_POLL_INTERVAL=5

# Voice Capabilities (Local Whisper & TTS)
LUNARIS_VOICE_DIR=./voice_cache
WHISPER_MODEL_SIZE=base

# Messaging Bot Connectors (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
